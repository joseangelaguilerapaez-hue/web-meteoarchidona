    "test:watch": "nodemon tests/ejecutar-todos.js",
    "lighthouse": "lighthouse https://localhost:8123 --view"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "keywords": [
