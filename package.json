{
  "name": "meteoarchidona",
  "version": "1.0.0",
  "description": "Plataforma de monitoreo meteorológico en tiempo real para la comarca de Archidona",
  "type": "module",
  "scripts": {
    "lint": "eslint js/ --fix",
    "format": "prettier --write .",
    "check": "eslint js/ && prettier --check .",
