# MeteoArchidona - Variables de Entorno
#
# Copiar este archivo a .env y completar los valores
# NUNCA commitear .env (usar .gitignore)

# API Configuration
API_BASE=https://api-meteoarchidona.onrender.com
API_TIMEOUT=5000

# CORS
CORS_ORIGIN=https://meteoarchidona.com

# Logging
LOG_LEVEL=error

# Feature Flags
FEATURE_PREDICTIONS=true
FEATURE_ALERTS=false
FEATURE_EXPORT=false

# Analytics (opcional)
ANALYTICS_ENABLED=false
ANALYTICS_ID=

# Security
RATE_LIMIT_PER_MINUTE=100

# Estaciones
STATIONS_ENABLED=EL_SILO,LOS_LLANOS
