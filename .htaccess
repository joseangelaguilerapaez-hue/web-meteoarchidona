# ============================================================
# MeteoArchidona — configuración del servidor
# ============================================================
#
# El sitio está alojado en Hostinger sobre LiteSpeed.
#
# Durante la fase activa de desarrollo se desactiva expresamente la
# caché propia de LiteSpeed para evitar que, después de un despliegue,
# el servidor continúe entregando versiones anteriores de las páginas.
#
# Durante esta misma fase de desarrollo se desactiva también la caché
# del navegador para documentos HTML y ficheros JavaScript.
#
# Esto es especialmente importante ahora que la web utiliza módulos ES:
#
#     principal.js
#         ↓
#     api.js
#     estado.js
#     estaciones.js
#     lluvia.js
#     ...
#
# Aunque el documento principal cambie de versión mediante ?v=, los
# módulos importados internamente pueden conservar su URL sin parámetro
# de versión. Por ello, mientras continúa la refactorización modular,
# no deben quedar almacenados durante días en la caché del navegador.
#
# Cuando el desarrollo de la web esté más estabilizado podremos volver
# a estudiar una política de caché selectiva.
# ============================================================


RewriteEngine On


# ============================================================
# LITESPEED
# ============================================================
#
# Hostinger utiliza LiteSpeed.
#
# Desactivamos tanto la caché pública como la privada para todo este
# sitio.
#
# Esto evita situaciones en las que:
#
# - se despliega una versión nueva;
# - GitHub y Hostinger ya contienen el fichero actualizado;
# - pero LiteSpeed continúa entregando una copia anterior.
#
# El problema se manifestó claramente en Actualidad:
#
#     /
#
# mostraba todavía dos estaciones mientras:
#
#     /pages/actualidad.html?v=117prueba
#
# mostraba correctamente las tres.
#
# No se activa CacheEnable en ningún punto de este fichero.

<IfModule LiteSpeed>

    CacheDisable public /
    CacheDisable private /

</IfModule>


# ============================================================
# PÁGINA DE INICIO
# ============================================================
#
# Al entrar en:
#
#     https://meteoarchidona.com/
#
# se sirve directamente:
#
#     pages/actualidad.html
#
# No se realiza ninguna redirección visible.

DirectoryIndex pages/actualidad.html


# ============================================================
# SEGURIDAD DE DIRECTORIOS
# ============================================================
#
# No permitir que el servidor muestre listados de carpetas.

Options -Indexes


# ============================================================
# DIRECCIONES LIMPIAS
# ============================================================
#
# Las páginas viven físicamente dentro de:
#
#     pages/
#
# pero públicamente se utilizan direcciones limpias:
#
#     /observaciones
#     /prediccion
#     /en-vivo
#     /administracion
#
# Actualidad constituye la portada y por tanto utiliza:
#
#     /
#
# Las redirecciones de URLs antiguas utilizan THE_REQUEST para evitar
# bucles con las reescrituras internas.


# ------------------------------------------------------------
# Actualidad
# ------------------------------------------------------------
#
# Todas estas direcciones antiguas terminan en la portada:
#
#     /index.html
#     /actualidad
#     /pages/actualidad.html

RewriteCond %{THE_REQUEST} \s/+(?:index\.html|actualidad|pages/actualidad\.html)[\s?] [NC]
RewriteRule ^ / [R=301,L]


# ------------------------------------------------------------
# En vivo
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?en-vivo\.html[\s?] [NC]
RewriteRule ^ /en-vivo [R=301,L]


# ------------------------------------------------------------
# Observaciones
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?observaciones\.html[\s?] [NC]
RewriteRule ^ /observaciones [R=301,L]


# ------------------------------------------------------------
# Administración
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?administracion\.html[\s?] [NC]
RewriteRule ^ /administracion [R=301,L]


# ------------------------------------------------------------
# Predicción
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+pages/prediccion\.html[\s?] [NC]
RewriteRule ^ /prediccion [R=301,L]


# ------------------------------------------------------------
# Información
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+pages/informacion\.html[\s?] [NC]
RewriteRule ^ /informacion [R=301,L]


# ------------------------------------------------------------
# Reescritura interna de direcciones limpias
# ------------------------------------------------------------

RewriteRule ^(observaciones|prediccion|en-vivo|administracion|informacion)/?$ pages/$1.html [L]


# ============================================================
# FICHEROS INTERNOS
# ============================================================
#
# No permitir acceso web a ficheros o carpetas cuyo nombre comienza
# por punto:
#
#     .git
#     .github
#     .gitignore
#     .htaccess
#
# Se conserva .well-known porque puede ser utilizado para la
# validación o renovación del certificado HTTPS.

RewriteRule (?:^|/)\.(?!well-known/) - [R=404,L]


# ============================================================
# CABECERAS DE SEGURIDAD
# ============================================================

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"

    Header always set X-Frame-Options "SAMEORIGIN"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

</IfModule>


# ============================================================
# HTML Y JAVASCRIPT — SIN CACHÉ DURANTE DESARROLLO
# ============================================================
#
# Además de desactivar la caché interna de LiteSpeed, los documentos
# HTML y los ficheros JavaScript tampoco deben quedar almacenados en
# el navegador durante la fase activa de desarrollo.
#
# Esto garantiza que, después de un despliegue, el navegador solicite
# siempre la versión actual.
#
# En JavaScript es especialmente importante por los módulos ES:
#
#     principal.js
#     api.js
#     estado.js
#     estaciones.js
#     lluvia.js
#     efectos-lluvia.js
#     ...
#
# Los imports internos pueden no llevar parámetro ?v= propio, por lo
# que permitir una caché larga puede mezclar versiones distintas de
# los módulos después de varios commits consecutivos.

<IfModule mod_headers.c>

    <FilesMatch "\.html$">

        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

        Header always set Pragma "no-cache"

        Header always set Expires "0"

    </FilesMatch>


    <FilesMatch "\.js$">

        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

        Header always set Pragma "no-cache"

        Header always set Expires "0"

    </FilesMatch>

</IfModule>


# ============================================================
# COMPRESIÓN
# ============================================================
#
# Comprimir recursos de texto enviados al navegador.

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/html

    AddOutputFilterByType DEFLATE text/plain

    AddOutputFilterByType DEFLATE text/css

    AddOutputFilterByType DEFLATE text/javascript

    AddOutputFilterByType DEFLATE application/javascript

    AddOutputFilterByType DEFLATE application/json

    AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>


# ============================================================
# CACHÉ DEL NAVEGADOR PARA RECURSOS ESTÁTICOS
# ============================================================
#
# Importante:
#
# Esta sección controla la caché del navegador.
#
# No contradice:
#
#     CacheDisable public /
#
# porque esa directiva anterior controla la caché interna de LiteSpeed.
#
# Política DURANTE DESARROLLO:
#
# HTML:
#     sin caché.
#
# JavaScript:
#     sin caché.
#
# CSS:
#     una semana.
#
# Imágenes:
#     un mes.
#
# Fuentes:
#     un año.
#
# Cuando la arquitectura modular esté estabilizada podremos volver a
# habilitar una política de caché de JavaScript basada en versionado
# explícito de recursos.

<IfModule mod_expires.c>

    ExpiresActive On


    # --------------------------------------------------------
    # Documentos
    # --------------------------------------------------------

    ExpiresByType text/html "access plus 0 seconds"


    # --------------------------------------------------------
    # CSS
    # --------------------------------------------------------

    ExpiresByType text/css "access plus 1 week"


    # --------------------------------------------------------
    # JavaScript
    # --------------------------------------------------------
    #
    # Sin caché durante desarrollo.
    #
    # Las cabeceras específicas definidas arriba fuerzan:
    #
    #     Cache-Control: no-store
    #     Pragma: no-cache
    #     Expires: 0
    #
    # Por ello no se establece aquí ningún ExpiresByType de una semana
    # para JavaScript.


    # --------------------------------------------------------
    # Imágenes
    # --------------------------------------------------------

    ExpiresByType image/jpeg "access plus 1 month"

    ExpiresByType image/png "access plus 1 month"

    ExpiresByType image/webp "access plus 1 month"

    ExpiresByType image/svg+xml "access plus 1 month"


    # --------------------------------------------------------
    # Fuentes
    # --------------------------------------------------------

    ExpiresByType font/woff2 "access plus 1 year"

</IfModule>


# ============================================================
# FIN
# ============================================================

# Fin de fichero: .htaccess