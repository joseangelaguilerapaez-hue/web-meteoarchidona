# ============================================================
# MeteoArchidona — configuración del servidor
# ============================================================
#
# El sitio está en Hostinger, que sirve con LiteSpeed y lee este
# fichero con la misma sintaxis que Apache. Si algún día se mudara a
# Nginx o a GitHub Pages, esto sería papel mojado y habría que
# rehacerlo donde toque.
#
# Nada de esto se puede probar en local: el servidor de pruebas de
# Python ignora el .htaccess. Se comprueba desplegado.

RewriteEngine On

# La portada es index.html, en la raíz.
DirectoryIndex index.html

# Nunca listar el contenido de una carpeta: sin esto, entrar en
# /assets/ o /js/ enseñaría el árbol entero del sitio.
Options -Indexes

# ------------------------------------------------------------
# Las páginas se mudaron a pages/
# ------------------------------------------------------------
#
# Hasta el 12-9-2026 vivían en la raíz. Quien tenga guardado un
# enlace viejo, o quien llegue desde un buscador, se encontraría
# un 404. El 301 dice "esto se ha mudado para siempre", que es lo
# que hace que el buscador cambie la dirección en su índice en vez
# de dejar la vieja rota.
#
# Cuando lleven un tiempo largo puestas y no aparezcan en los
# registros del servidor, se pueden quitar.

Redirect 301 /en-vivo.html         /pages/en-vivo.html
Redirect 301 /observaciones.html   /pages/observaciones.html
Redirect 301 /administracion.html  /pages/administracion.html


# ------------------------------------------------------------
# Ficheros que no son del sitio
# ------------------------------------------------------------
#
# Nada que empiece por punto se sirve, ni fichero ni carpeta: .git,
# .github, el propio .htaccess. Va sobre la ruta y no con FilesMatch
# porque FilesMatch casa nombres de fichero y no rutas, así que
# bloquearía un fichero llamado ".git" pero dejaría pasar
# "/.git/config", que da la dirección del repositorio y con ella todo
# el código.
#
# .well-known se salva: por ahí pasa la renovación del certificado.

RewriteRule (?:^|/)\.(?!well-known/) - [R=404,L]


# ------------------------------------------------------------
# Cabeceras de seguridad
# ------------------------------------------------------------
#
# Strict-Transport-Security obliga al navegador a entrar por HTTPS
# durante un año, incluso escribiendo http:// a mano. Con el
# certificado de Hostinger puesto es lo correcto, pero conviene
# saberlo: si el sitio se quedara sin HTTPS, quien ya haya entrado no
# podría volver hasta que caduque el plazo.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>


# ------------------------------------------------------------
# Compresión
# ------------------------------------------------------------
#
# Texto plano comprimido al vuelo. Es de donde sale casi toda la
# ganancia de peso: css/administracion.css y js/administracion.js
# suman más de 100 KB y son texto repetitivo.

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# ------------------------------------------------------------
# Caché del navegador
# ------------------------------------------------------------
#
# El HTML caduca en una hora, así que un cambio se ve pronto. Las
# hojas y los scripts duran una semana, y por eso sus enlaces llevan
# "?v=" en el HTML: al publicar hay que subir ese número, o el
# visitante seguirá con la versión vieja hasta que caduque.
#
# Las imágenes duran un mes: no cambian, y si cambian se sube una con
# otro nombre.

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
