# ============================================================
# MeteoArchidona — configuración del servidor
# ============================================================
#
# El sitio está en Hostinger, que sirve con LiteSpeed y lee este
# fichero con la misma sintaxis que Apache. Si algún día se mudara a
# Nginx o a GitHub Pages, esto sería papel mojado y habría que
# rehacerlo donde toque.
#
# Nada de esto se puede probar en local: el servidor de pruebas de
# Python ignora el .htaccess. Se comprueba desplegado.

RewriteEngine On

# Al entrar en "/" sale Actualidad. No es una redirección: se sirve
# esa página directamente, así que la dirección de la portada es
# meteoarchidona.com y no meteoarchidona.com/actualidad.
DirectoryIndex pages/actualidad.html

# Nunca listar el contenido de una carpeta: sin esto, entrar en
# /assets/ o /js/ enseñaría el árbol entero del sitio.
Options -Indexes


# ------------------------------------------------------------
# Direcciones limpias
# ------------------------------------------------------------
#
# Las páginas viven en pages/ y se sirven sin carpeta y sin
# extensión: /en-vivo, /observaciones, /prediccion, /administracion.
# La barra del navegador enseña eso y no la ruta del fichero.
#
# Es una reescritura interna, no una redirección: el visitante pide
# /en-vivo y el servidor le da pages/en-vivo.html sin más viajes.
#
# Las redirecciones de las direcciones viejas van antes, y todas
# miran THE_REQUEST, que es la línea que mandó el navegador. Si
# miraran la ruta a secas entrarían en bucle: la reescritura interna
# convierte /en-vivo en pages/en-vivo.html, eso vuelve a pasar por
# estas reglas, y pages/en-vivo.html redirige otra vez a /en-vivo.

# --- Direcciones viejas, a la nueva con un 301 permanente ---
#
# Todo lo que ya circula por ahí —enlaces guardados, resultados de
# buscador— tiene que acabar en la dirección buena. El 301 es lo que
# hace que el buscador cambie su índice en vez de dejar la vieja
# rota.
#
# Actualidad es la portada, así que su dirección buena es "/". Que
# además exista /actualidad repartiría el crédito entre dos
# direcciones para la misma página, así que también redirige.

RewriteCond %{THE_REQUEST} \s/+(?:index\.html|actualidad|pages/actualidad\.html)[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?en-vivo\.html[\s?] [NC]
RewriteRule ^ /en-vivo [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?observaciones\.html[\s?] [NC]
RewriteRule ^ /observaciones [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?administracion\.html[\s?] [NC]
RewriteRule ^ /administracion [R=301,L]

RewriteCond %{THE_REQUEST} \s/+pages/prediccion\.html[\s?] [NC]
RewriteRule ^ /prediccion [R=301,L]

# --- Y la reescritura interna de las direcciones limpias ---

RewriteRule ^(observaciones|prediccion|en-vivo|administracion)/?$ pages/$1.html [L]


# ------------------------------------------------------------
# Ficheros que no son del sitio
# ------------------------------------------------------------
#
# Nada que empiece por punto se sirve, ni fichero ni carpeta: .git,
# .github, el propio .htaccess. Va sobre la ruta y no con FilesMatch
# porque FilesMatch casa nombres de fichero y no rutas, así que
# bloquearía un fichero llamado ".git" pero dejaría pasar
# "/.git/config", que da la dirección del repositorio y con ella todo
# el código.
#
# .well-known se salva: por ahí pasa la renovación del certificado.

RewriteRule (?:^|/)\.(?!well-known/) - [R=404,L]


# ------------------------------------------------------------
# Cabeceras de seguridad
# ------------------------------------------------------------
#
# Strict-Transport-Security obliga al navegador a entrar por HTTPS
# durante un año, incluso escribiendo http:// a mano. Con el
# certificado de Hostinger puesto es lo correcto, pero conviene
# saberlo: si el sitio se quedara sin HTTPS, quien ya haya entrado no
# podría volver hasta que caduque el plazo.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>


# ------------------------------------------------------------
# Caché de documentos HTML
# ------------------------------------------------------------
#
# Los documentos HTML cambian con frecuencia durante el desarrollo de
# MeteoArchidona y además contienen las referencias versionadas a CSS
# y JavaScript.
#
# No deben permanecer almacenados en el navegador durante una hora,
# porque después de un despliegue podría seguir utilizándose una
# versión antigua del documento aunque CSS y JavaScript ya sean los
# nuevos.
#
# Esto afecta también a:
#
# - pages/actualidad.html;
# - pages/observaciones.html;
# - pages/prediccion.html;
# - pages/en-vivo.html;
# - pages/administracion.html;
# - componentes/cabecera.html;
# - cualquier futuro documento HTML.
#
# El navegador deberá solicitar/revalidar siempre estos documentos.
#
# CSS, JavaScript, imágenes y fuentes mantienen más abajo sus tiempos
# largos de caché.

<IfModule mod_headers.c>

    <FilesMatch "\.html$">

        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"

    </FilesMatch>

</IfModule>


# ------------------------------------------------------------
# Compresión
# ------------------------------------------------------------
#
# Texto plano comprimido al vuelo. Es de donde sale casi toda la
# ganancia de peso: css/administracion.css y js/administracion.js
# suman más de 100 KB y son texto repetitivo.

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# ------------------------------------------------------------
# Caché del navegador
# ------------------------------------------------------------
#
# Los documentos HTML no se almacenan y deben solicitarse/revalidarse
# siempre. La política se refuerza tanto mediante mod_headers como
# mediante un tiempo de expiración de cero segundos.
#
# Las hojas de estilo y los scripts duran una semana. Sus enlaces
# utilizan "?v=" en los documentos HTML para cambiar de URL cuando se
# publica una nueva versión.
#
# Las imágenes duran un mes: normalmente no cambian y, cuando cambian,
# se publica una nueva versión o nombre de recurso.

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType text/html "access plus 0 seconds"

    ExpiresByType text/css "access plus 1 week"

    ExpiresByType application/javascript "access plus 1 week"

    ExpiresByType image/jpeg "access plus 1 month"

    ExpiresByType image/png "access plus 1 month"

    ExpiresByType image/webp "access plus 1 month"

    ExpiresByType image/svg+xml "access plus 1 month"

    ExpiresByType font/woff2 "access plus 1 year"

</IfModule>


# Fin de fichero: .htaccess