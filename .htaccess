# ============================================================
# MeteoArchidona — configuración del servidor
# ============================================================
#
# El sitio está alojado en Hostinger sobre LiteSpeed.
#
# Durante la fase activa de desarrollo se mantiene desactivada
# expresamente la caché propia de LiteSpeed para evitar que, después
# de un despliegue, el servidor continúe entregando versiones
# anteriores de las páginas o recursos.
#
# Los documentos HTML tampoco se almacenan en caché en el navegador.
#
# Los recursos JavaScript sí pueden utilizar caché de navegador porque
# se publican con versionado explícito mediante parámetros ?v=.
#
# En la arquitectura modular de Actualidad todas las dependencias de
# una misma generación utilizan el mismo identificador de versión:
#
#     principal.js?v=...
#         ↓
#     api.js?v=...
#     estado.js?v=...
#     estaciones.js?v=...
#     lluvia.js?v=...
#     efectos-lluvia.js?v=...
#     ...
#
# Cuando se publique una nueva generación del grafo modular deberá
# actualizarse su identificador de versión para invalidar de forma
# controlada la caché anterior.
# ============================================================


RewriteEngine On


# ============================================================
# LITESPEED
# ============================================================
#
# Hostinger utiliza LiteSpeed.
#
# Desactivamos tanto la caché pública como la privada para todo este
# sitio.
#
# Esto evita situaciones en las que:
#
# - se despliega una versión nueva;
# - GitHub y Hostinger ya contienen el fichero actualizado;
# - pero LiteSpeed continúa entregando una copia anterior.
#
# El problema se manifestó claramente en Actualidad:
#
#     /
#
# mostraba todavía dos estaciones mientras:
#
#     /pages/actualidad.html?v=117prueba
#
# mostraba correctamente las tres.
#
# No se activa CacheEnable en ningún punto de este fichero.

<IfModule LiteSpeed>

    CacheDisable public /
    CacheDisable private /

</IfModule>


# ============================================================
# PÁGINA DE INICIO
# ============================================================
#
# Al entrar en:
#
#     https://meteoarchidona.com/
#
# se sirve directamente:
#
#     pages/actualidad.html
#
# No se realiza ninguna redirección visible.

DirectoryIndex pages/actualidad.html


# ============================================================
# SEGURIDAD DE DIRECTORIOS
# ============================================================
#
# No permitir que el servidor muestre listados de carpetas.

Options -Indexes


# ============================================================
# DIRECCIONES LIMPIAS
# ============================================================
#
# Las páginas viven físicamente dentro de:
#
#     pages/
#
# pero públicamente se utilizan direcciones limpias:
#
#     /observaciones
#     /prediccion
#     /en-vivo
#     /administracion
#
# Actualidad constituye la portada y por tanto utiliza:
#
#     /
#
# Las redirecciones de URLs antiguas utilizan THE_REQUEST para evitar
# bucles con las reescrituras internas.


# ------------------------------------------------------------
# Actualidad
# ------------------------------------------------------------
#
# Todas estas direcciones antiguas terminan en la portada:
#
#     /index.html
#     /actualidad
#     /pages/actualidad.html

RewriteCond %{THE_REQUEST} \s/+(?:index\.html|actualidad|pages/actualidad\.html)[\s?] [NC]
RewriteRule ^ / [R=301,L]


# ------------------------------------------------------------
# En vivo
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?en-vivo\.html[\s?] [NC]
RewriteRule ^ /en-vivo [R=301,L]


# ------------------------------------------------------------
# Observaciones
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?observaciones\.html[\s?] [NC]
RewriteRule ^ /observaciones [R=301,L]


# ------------------------------------------------------------
# Administración
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(?:pages/)?administracion\.html[\s?] [NC]
RewriteRule ^ /administracion [R=301,L]


# ------------------------------------------------------------
# Predicción
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+pages/prediccion\.html[\s?] [NC]
RewriteRule ^ /prediccion [R=301,L]


# ------------------------------------------------------------
# Información
# ------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+pages/informacion\.html[\s?] [NC]
RewriteRule ^ /informacion [R=301,L]


# ------------------------------------------------------------
# Reescritura interna de direcciones limpias
# ------------------------------------------------------------

RewriteRule ^(observaciones|prediccion|en-vivo|administracion|informacion)/?$ pages/$1.html [L]


# ============================================================
# FICHEROS INTERNOS
# ============================================================
#
# No permitir acceso web a ficheros o carpetas cuyo nombre comienza
# por punto:
#
#     .git
#     .github
#     .gitignore
#     .htaccess
#
# Se conserva .well-known porque puede ser utilizado para la
# validación o renovación del certificado HTTPS.

RewriteRule (?:^|/)\.(?!well-known/) - [R=404,L]


# ============================================================
# CABECERAS DE SEGURIDAD
# ============================================================

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"

    Header always set X-Frame-Options "SAMEORIGIN"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

</IfModule>


# ============================================================
# POLÍTICA DE CACHÉ DE HTML Y JAVASCRIPT
# ============================================================
#
# Los documentos HTML no se almacenan en caché.
#
# Esto permite que, después de un despliegue, el navegador obtenga
# inmediatamente el HTML actual y con él los identificadores ?v=
# correspondientes a la nueva generación de recursos.
#
# JavaScript utiliza caché de navegador durante una semana.
#
# La invalidación de JavaScript se realiza mediante versionado
# explícito de las URLs:
#
#     fichero.js?v=identificador
#
# En los módulos ES todas las dependencias de una misma generación
# deben utilizar el mismo identificador de versión.

<IfModule mod_headers.c>

    <FilesMatch "\.html$">

        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

        Header always set Pragma "no-cache"

        Header always set Expires "0"

    </FilesMatch>


    <FilesMatch "\.js$">

        Header always set Cache-Control "public, max-age=604800"

        Header always unset Pragma

    </FilesMatch>

</IfModule>


# ============================================================
# COMPRESIÓN
# ============================================================
#
# Comprimir recursos de texto enviados al navegador.

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/html

    AddOutputFilterByType DEFLATE text/plain

    AddOutputFilterByType DEFLATE text/css

    AddOutputFilterByType DEFLATE text/javascript

    AddOutputFilterByType DEFLATE application/javascript

    AddOutputFilterByType DEFLATE application/json

    AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>


# ============================================================
# CACHÉ DEL NAVEGADOR PARA RECURSOS ESTÁTICOS
# ============================================================
#
# Importante:
#
# Esta sección controla la caché del navegador.
#
# No contradice:
#
#     CacheDisable public /
#
# porque esa directiva anterior controla la caché interna de LiteSpeed.
#
# Política actual:
#
# HTML:
#     sin caché.
#
# JavaScript:
#     una semana.
#
# CSS:
#     una semana.
#
# Imágenes:
#     un mes.
#
# Fuentes:
#     un año.
#
# Los recursos JavaScript deben publicarse con un identificador ?v=
# nuevo cada vez que se modifique una generación que deba sustituir
# inmediatamente a la anterior.

<IfModule mod_expires.c>

    ExpiresActive On


    # --------------------------------------------------------
    # Documentos
    # --------------------------------------------------------

    ExpiresByType text/html "access plus 0 seconds"


    # --------------------------------------------------------
    # CSS
    # --------------------------------------------------------

    ExpiresByType text/css "access plus 1 week"


    # --------------------------------------------------------
    # JavaScript
    # --------------------------------------------------------

    ExpiresByType text/javascript "access plus 1 week"

    ExpiresByType application/javascript "access plus 1 week"


    # --------------------------------------------------------
    # Imágenes
    # --------------------------------------------------------

    ExpiresByType image/jpeg "access plus 1 month"

    ExpiresByType image/png "access plus 1 month"

    ExpiresByType image/webp "access plus 1 month"

    ExpiresByType image/svg+xml "access plus 1 month"


    # --------------------------------------------------------
    # Fuentes
    # --------------------------------------------------------

    ExpiresByType font/woff2 "access plus 1 year"

</IfModule>


# ============================================================
# FIN
# ============================================================

# Fin de fichero: .htaccess