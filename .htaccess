# ============================================================
# MeteoArchidona — configuración del servidor
# ============================================================

RewriteEngine On

# La página principal es index.html, en la raíz. Sin esto, entrar
# en "/" no encontraría índice y el servidor respondería con el
# listado del directorio, enseñando todo el repositorio.
DirectoryIndex index.html

# Y aunque haya índice, nunca listar el contenido de una carpeta.
Options -Indexes

# Nada que empiece por punto se sirve, ni fichero ni carpeta: .git,
# .env, .github, el propio .htaccess. Va con RewriteRule y no con
# FilesMatch porque FilesMatch casa nombres de fichero y no rutas, así
# que ".git" bloqueaba un fichero llamado ".git" pero dejaba pasar
# "/.git/config", que es justo el que enseña la dirección del
# repositorio y desde ahí se puede reconstruir el código entero.
#
# .well-known se salva: por ahí pasa la renovación del certificado.
RewriteRule (?:^|/)\.(?!well-known/) - [R=404,L]

# La dirección de la portada es "/", no "/index.html". Si se deja
# entrar por las dos, el nombre del archivo se queda en la barra y
# se arrastra a las secciones ("/index.html#info"), y además la
# misma página queda accesible desde dos direcciones distintas.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# HTTPS Obligatorio (descomenta en producción)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Aquí había un bloque de cabeceras CORS "para la API". No servía:
# CORS lo decide quien responde a la petición, y a la API le responde
# la API, no este servidor. Lo único que hacía era anunciar que las
# páginas de este sitio se pueden leer desde meteoarchidona.com, que
# es este mismo sitio. Las cabeceras de verdad las manda el
# CORSMiddleware de FastAPI desde el 10-9-2026.

# Compresión de respuestas
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Cache Control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

# Los .json del proyecto (package.json, package-lock.json) no son
# contenido del sitio y cuentan las versiones exactas de todo lo que
# usa. El mapa no cae aquí: datos/localidades-radar.geojson no termina
# en ".json".
#
# Antes esto iba en un FilesMatch con "Order allow,deny", que es
# sintaxis de Apache 2.2: en un 2.4 sin mod_access_compat el servidor
# ni arranca la configuración.
RewriteRule \.json$ - [R=404,L]

# Las páginas de sección viven en pages/; index.html en la raíz
RewriteRule ^(info|prediccion|en-vivo|observaciones|aviso-legal)\.html$ pages/$1.html [L]

# SPA: rutas sin extensión a index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
